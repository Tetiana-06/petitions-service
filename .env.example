# Шаблон змінних оточення проєкту (Environment Variables Template)
# Скопіюйте цей файл у .env.sandbox або .env.production та заповніть значення
APP_ENV=sandbox
PROJECT_NAME="Local Petitions Service"
DEBUG=True
DATABASE_URL=sqlite+aiosqlite:///src/petitions_sandbox.db
DB_ECHO=False
SECRET_KEY=your-secure-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
SEED_DEMO_DATA=True
