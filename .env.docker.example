# Шаблон для Docker: скопіюйте у файл .env (cp .env.docker.example .env)
# --- PostgreSQL ---
POSTGRES_USER=petitions
POSTGRES_PASSWORD=change-me
POSTGRES_DB=petitions

# --- Застосунок ---
APP_ENV=docker
PROJECT_NAME="Local Petitions Service [Docker]"
DEBUG=False
DATABASE_URL=postgresql+asyncpg://petitions:change-me@db:5432/petitions
DB_ECHO=False
SECRET_KEY=change-me-docker-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
SEED_DEMO_DATA=True
